# ==============================================================================
# HERMES AI AGENT - MULTI-PROVIDER LLM CONFIGURATION
# ==============================================================================

# LLM Provider Automatic Failover Hierarchy:
# 1. Gemini API Key 1 — Primary provider (GEMINI_API_KEY_1 or GEMINI_API_KEY)
# 2. Gemini API Key 2 — First backup (GEMINI_API_KEY_2)
# 3. Gemini API Key 3 — Second backup (GEMINI_API_KEY_3)
# 4. APInex          — Final fallback (APINEX_API_KEY)
# 5. Local Ollama    — Offline execution fallback
#
# Aliases supported: LLM_PROVIDER or MODEL_PROVIDER
LLM_PROVIDER=google-gemini
MODEL_PROVIDER=google-gemini

# ------------------------------------------------------------------------------
# PRIMARY PROVIDER: GOOGLE GEMINI (3-Key Automatic Failover Chain)
# Google AI Studio OpenAI-compatible endpoint: https://aistudio.google.com/
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai/
# ------------------------------------------------------------------------------
# Priority 1: Primary Gemini Key
GEMINI_API_KEY_1=
# Legacy alias for Key 1:
GEMINI_API_KEY=

# Priority 2: First Backup Gemini Key (Optional - automatically rotated when Key 1 reaches quota)
GEMINI_API_KEY_2=

# Priority 3: Second Backup Gemini Key (Optional - automatically rotated when Keys 1 & 2 reach quota)
GEMINI_API_KEY_3=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# Supported Gemini Model IDs:
# - gemini-2.5-flash (Fast, recommended)
# - gemini-2.0-flash
# - gemini-1.5-flash
# - gemini-3.5-flash-lite
# - gemini-1.5-pro

# Automatic Failover & Recovery Cooldown Settings (Seconds)
GEMINI_COOLDOWN_SECONDS=60
GEMINI_SHORT_COOLDOWN_SECONDS=30
TURN_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# FINAL FALLBACK: APINEX (OpenAI-compatible unified gateway)
# https://apinex.bond/models | Base URL: https://api.apinex.bond/v1
# Free allowance: 10M tokens/day for models marked FREE in your account
# ------------------------------------------------------------------------------
APINEX_API_KEY=your_apinex_api_key_here
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/gemini-3.8-flash

# Verified Free-Tier APInex Model IDs (0 cost, allowFree: true):
# - free/gemini-3.8-flash (Recommended default)
# - free/deepseek-v4.1-flash
# - free/gpt-6-luna
# - free/glm-5.3-flash
# - free/qwen-3.8-max
# - free/deepseek-v4-flash-0731
# - free/deepseek-v4-pro-0813
# - free/mimo-v2.6-pro

# ------------------------------------------------------------------------------
# BACKUP 2: GROQ (Ultra-fast LPU inference endpoint)
# https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Supported Groq Model IDs:
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# OFFLINE FALLBACK: LOCAL OLLAMA (MacBook Air M4 offline execution, no API key required)
# http://localhost:11434
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b-hermes

# ------------------------------------------------------------------------------
# LEGACY / GENERIC COMPATIBILITY VARIABLES
# ------------------------------------------------------------------------------
# API_BASE_URL=https://api.apinex.bond/v1
# MODEL_NAME=free/gemini-3.8-flash

# ==============================================================================
# HERMES DEV STUDIO - CONTAINER EXECUTION & SECURITY SETTINGS
# ==============================================================================

# Enable Docker Container Sandbox Isolation (true | false)
HERMES_ENABLE_DOCKER=true

# Unprivileged Container Execution Settings
HERMES_DOCKER_IMAGE=node:20-alpine
HERMES_DOCKER_CPU_LIMIT=1.0
HERMES_DOCKER_MEMORY_LIMIT=512m
HERMES_DOCKER_PIDS_LIMIT=64
HERMES_DOCKER_NETWORK=none

# Container Sandbox Runtime Engine
# Options: runc (default Docker) | runsc (gVisor for untrusted public launch)
HERMES_SANDBOX_RUNTIME=runc

# Reverse Proxy & Port Settings
PORT=8000
HOST=127.0.0.1
